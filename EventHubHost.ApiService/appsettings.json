{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Ollama": {
    "Endpoint": "http://localhost:11434",
    "Model": "llama3.2:3b",
    "EmbeddingModel": "nomic-embed-text",
    "AutoPullModel": true
  },
  "Qdrant": {
    "Endpoint": "http://localhost:6333",
    "Collection": "events",
    "InsightCollection": "insights",
    "VectorSize": 768
  },
  "Correlation": {
    "TemporalWindowSeconds": 15,
    "VectorSearchTopK": 12,
    "MaxRecentEventsForPrompt": 30,
    "InsightMemoryTopK": 3
  },
  "Anomaly": {
    "Enabled": true,
    "ScanIntervalSeconds": 30,
    "WindowSeconds": 300,
    "BinSeconds": 5,
    "MinPointsToScan": 24,
    "Sensitivity": 90.0
  },
  "Llm": {
    "UseGpu": false
  },
  "AllowedHosts": "*"
}
