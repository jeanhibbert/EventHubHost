@page "/"
@rendermode InteractiveServer

@inject CorrelationApiClient CorrelationApi

<PageTitle>Home</PageTitle>

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
	<div>
		<h1 class="mb-1">Event Correlation</h1>
		<p class="text-secondary mb-0">Centralized LLM insight over System A and System B events.</p>
	</div>
	<div class="d-flex gap-2">
		<button class="btn btn-outline-secondary" @onclick="RefreshAsync" disabled="@busy">Refresh</button>
		<button class="btn btn-primary" @onclick="TriggerScenarioAsync" disabled="@busy">Trigger A type 2</button>
	</div>
</div>

@if (!string.IsNullOrWhiteSpace(error))
{
	<div class="alert alert-warning" role="alert">@error</div>
}

@if (status is null)
{
	<p><em>Loading event stream...</em></p>
}
else
{
	<div class="row g-3 mb-4">
		<div class="col-sm-6 col-xl-3">
			<div class="metric-panel">
				<span>Total events</span>
				<strong>@status.TotalEvents</strong>
			</div>
		</div>
		<div class="col-sm-6 col-xl-3">
			<div class="metric-panel">
				<span>A type 2</span>
				<strong>@status.SystemAType2Events</strong>
			</div>
		</div>
		<div class="col-sm-6 col-xl-3">
			<div class="metric-panel">
				<span>B unique</span>
				<strong>@status.SystemBUniqueEvents</strong>
			</div>
		</div>
		<div class="col-sm-6 col-xl-3">
			<div class="metric-panel">
				<span>Matched keys</span>
				<strong>@status.MatchedCorrelationKeys</strong>
			</div>
		</div>
	</div>

	<section class="mb-4">
		<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
			<h2 class="h5 mb-0">Ask the LLM</h2>
			<span class="badge @(status.VectorStoreAvailable ? "text-bg-success" : "text-bg-warning")">
				Vector DB @(status.VectorStoreAvailable ? "online" : "fallback")
			</span>
		</div>
		<textarea class="form-control mb-2" rows="3" @bind="question"></textarea>
		<button class="btn btn-primary" @onclick="AskAsync" disabled="@busy || string.IsNullOrWhiteSpace(question)">Ask</button>
	</section>

	@if (insight is not null)
	{
		<section class="insight-panel mb-4">
			<div class="d-flex flex-wrap justify-content-between gap-2 mb-2">
				<h2 class="h5 mb-0">Insight</h2>
				<span class="badge @(insight.UsedLlm ? "text-bg-success" : "text-bg-secondary")">
					@(insight.UsedLlm ? "Ollama" : "Local fallback")
				</span>
			</div>
			<p class="mb-0 whitespace-preserve">@insight.Answer</p>
		</section>
	}

	<section>
		<h2 class="h5">Recent events</h2>
		<div class="table-responsive">
			<table class="table table-sm align-middle">
				<thead>
					<tr>
						<th>Time</th>
						<th>System</th>
						<th>Type</th>
						<th>Event</th>
						<th>Correlation key</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var eventItem in status.RecentEvents)
					{
						<tr>
							<td>@eventItem.OccurredAt.ToLocalTime().ToString("HH:mm:ss")</td>
							<td>@eventItem.SourceSystem</td>
							<td>@eventItem.EventType</td>
							<td>@eventItem.Name</td>
							<td><code>@eventItem.CorrelationKey</code></td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</section>
}

@code {
	private CorrelationStatus? status;
	private CorrelationQueryResponse? insight;
	private string question = "Has System A event type 2 caused a unique event in System B?";
	private string? error;
	private bool busy;

	protected override async Task OnInitializedAsync()
	{
		await RefreshAsync();
	}

	private async Task RefreshAsync()
	{
		await RunAsync(async () => status = await CorrelationApi.GetStatusAsync());
	}

	private async Task TriggerScenarioAsync()
	{
		await RunAsync(async () =>
		{
			await CorrelationApi.TriggerType2ScenarioAsync();
			status = await CorrelationApi.GetStatusAsync();
		});
	}

	private async Task AskAsync()
	{
		await RunAsync(async () =>
		{
			insight = await CorrelationApi.AskAsync(question);
			status = await CorrelationApi.GetStatusAsync();
		});
	}

	private async Task RunAsync(Func<Task> action)
	{
		busy = true;
		error = null;
		try
		{
			await action();
		}
		catch (Exception ex)
		{
			error = ex.Message;
		}
		finally
		{
			busy = false;
		}
	}
}
