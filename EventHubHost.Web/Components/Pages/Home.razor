@page "/"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.Extensions.Options

@inject CorrelationApiClient CorrelationApi
@inject IOptions<CorrelationApiOptions> CorrelationApiOptions

<PageTitle>Home</PageTitle>

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
	<div>
		<h1 class="mb-1">Event Correlation</h1>
		<p class="text-secondary mb-0">Centralized LLM insight over System A and System B events.</p>
	</div>
	<div class="d-flex gap-2">
		<button class="btn btn-outline-secondary" @onclick="RefreshAsync" disabled="@busy">Refresh</button>
		<button class="btn btn-primary" @onclick="TriggerScenarioAsync" disabled="@busy">Trigger A type 2</button>
	</div>
</div>

@if (!string.IsNullOrWhiteSpace(error))
{
	<div class="alert alert-warning" role="alert">@error</div>
}

@if (status is null)
{
	<p><em>Loading event stream...</em></p>
}
else
{
	<div class="row g-3 mb-4">
		<div class="col-sm-6 col-xl-3">
			<div class="metric-panel">
				<span>Total events</span>
				<strong>@status.TotalEvents</strong>
			</div>
		</div>
		<div class="col-sm-6 col-xl-3">
			<div class="metric-panel">
				<span>A type 2</span>
				<strong>@status.SystemAType2Events</strong>
			</div>
		</div>
		<div class="col-sm-6 col-xl-3">
			<div class="metric-panel">
				<span>B unique</span>
				<strong>@status.SystemBUniqueEvents</strong>
			</div>
		</div>
		<div class="col-sm-6 col-xl-3">
			<div class="metric-panel">
				<span>Temporal matches</span>
				<strong class="@(status.TemporalMatches > 0 ? "text-success" : string.Empty)">@status.TemporalMatches</strong>
			</div>
		</div>
	</div>

	<section class="mb-4">
		<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
			<h2 class="h5 mb-0">Ask the LLM</h2>
			<span class="badge @(status.SqlStoreAvailable ? "text-bg-success" : "text-bg-warning")">
				SQL dataset @(status.SqlStoreAvailable ? "online" : "offline")
			</span>
			<span class="badge @(status.VectorStoreAvailable ? "text-bg-success" : "text-bg-warning")">
				Vector DB @(status.VectorStoreAvailable ? "online" : "offline")
			</span>
		</div>
		<p class="text-secondary small mb-2">Matching window: @status.TemporalWindowSeconds seconds after a System A type 2 event. Embedding model: <code>@status.EmbeddingModel</code>.</p>
		<textarea class="form-control mb-2" rows="3" @bind="question"></textarea>
		<div class="d-flex gap-2 mb-2">
			<button class="btn btn-primary" @onclick="AskStreamingAsync" disabled="@(busy || string.IsNullOrWhiteSpace(question))">Ask (streaming)</button>
			<button class="btn btn-outline-secondary" @onclick="AskAsync" disabled="@(busy || string.IsNullOrWhiteSpace(question))">Ask (synchronous)</button>
		</div>
	</section>

	@if (anomalyAlerts.Count > 0)
	{
		<section class="mb-4">
			<h2 class="h5">Anomaly notifications</h2>
			<ul class="list-unstyled mb-0">
				@foreach (var alert in anomalyAlerts)
				{
					<li class="alert alert-info py-2 mb-2">
						<div class="d-flex flex-wrap justify-content-between gap-2">
							<div class="d-flex flex-wrap align-items-center gap-2">
								<strong>@alert.SourceSystem@(alert.EventType.HasValue ? $" type {alert.EventType.Value}" : string.Empty)</strong>
								<span class="badge @SeverityBadgeClass(alert.Severity)">@alert.Severity</span>
								<span class="badge @(alert.UsedLlm ? "text-bg-success" : "text-bg-secondary")">@(alert.UsedLlm ? "Ollama" : "SQL")</span>
							</div>
							<span class="small text-secondary">@alert.DetectedAt.ToLocalTime().ToString("HH:mm:ss") &middot; observed @alert.ObservedRate.ToString("0.##") vs expected @alert.ExpectedRate.ToString("0.##")</span>
						</div>
						<div class="small whitespace-preserve mt-1">@alert.Explanation</div>
					</li>
				}
			</ul>
		</section>
	}

	@if (streamingDeterministic is not null)
	{
		<section class="insight-panel mb-4">
			<div class="d-flex flex-wrap justify-content-between gap-2 mb-2">
				<h2 class="h5 mb-0">Deterministic answer (instant)</h2>
				<span class="badge text-bg-info">SQL</span>
			</div>
			<p class="mb-0 whitespace-preserve">@streamingDeterministic</p>
		</section>

		<section class="insight-panel mb-4">
			<div class="d-flex flex-wrap justify-content-between gap-2 mb-2">
				<h2 class="h5 mb-0">LLM elaboration @(streamingCompleted ? "" : "(streaming…)")</h2>
				<span class="badge @(streamingCompleted ? "text-bg-success" : "text-bg-secondary")">
					@(streamingCompleted ? "Done" : "Streaming")
				</span>
			</div>
			<p class="mb-0 whitespace-preserve">@streamingTokens</p>
		</section>
	}

	@if (insight is not null)
	{
		<section class="insight-panel mb-4">
			<div class="d-flex flex-wrap justify-content-between gap-2 mb-2">
				<h2 class="h5 mb-0">Insight</h2>
				<span class="badge @(insight.UsedLlm ? "text-bg-success" : "text-bg-secondary")">
					@(insight.UsedLlm ? "Ollama" : "Local fallback")
				</span>
			</div>
			<p class="mb-0 whitespace-preserve">@insight.Answer</p>
		</section>
	}

	<section class="mb-4">
		<details>
			<summary class="h5 mb-2" style="cursor: pointer;">Insight history (@insightHistory.Count)</summary>
			@if (insightHistory.Count == 0)
			{
				<p class="text-secondary small mb-0">No prompts have been asked yet.</p>
			}
			else
			{
				<ul class="list-unstyled mb-0">
					@foreach (var record in insightHistory)
					{
						<li class="border rounded p-2 mb-2">
							<div class="d-flex flex-wrap justify-content-between gap-2 mb-1">
								<strong class="small">@record.AskedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</strong>
								<span class="badge @(record.UsedLlm ? "text-bg-success" : "text-bg-secondary")">
									@(record.UsedLlm ? "Ollama" : "Local fallback")
								</span>
							</div>
							<div class="small text-secondary mb-1">Vector matches: @record.VectorMatchCount &middot; SQL events: @record.RecentEventCount &middot; Temporal: @record.TemporalMatches</div>
							<div class="mb-1"><em>Q:</em> @record.Question</div>
							<div class="whitespace-preserve"><em>A:</em> @record.Answer</div>
						</li>
					}
				</ul>
			}
		</details>
	</section>

	<section>
		<h2 class="h5">Recent events</h2>
		<div class="table-responsive">
			<table class="table table-sm align-middle">
				<thead>
					<tr>
						<th>Time</th>
						<th>System</th>
						<th>Type</th>
						<th>Event</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var eventItem in status.RecentEvents)
					{
						<tr class="@EventRowClass(eventItem)">
							<td>@eventItem.OccurredAt.ToLocalTime().ToString("HH:mm:ss")</td>
							<td>@eventItem.SourceSystem</td>
							<td>@eventItem.EventType</td>
							<td>@eventItem.Name</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</section>
}

@code {
	private CorrelationStatus? status;
	private CorrelationQueryResponse? insight;
	private IReadOnlyList<InsightRecord> insightHistory = [];
	private IReadOnlyList<AnomalyRecord> anomalyAlerts = [];
	private string question = "Does the SQL event history show that System B unique events tend to happen shortly after System A type 2 events?";
	private string? error;
	private bool busy;
	private HubConnection? hubConnection;

	private Guid? activeStreamId;
	private string? streamingDeterministic;
	private string streamingTokens = string.Empty;
	private bool streamingCompleted;

	protected override async Task OnInitializedAsync()
	{
		await RefreshAsync();
		await ConnectEventStreamAsync();
	}

	private async Task ConnectEventStreamAsync()
	{
		hubConnection = new HubConnectionBuilder()
			.WithUrl(CorrelationApiOptions.Value.EventHubUrl)
			.WithAutomaticReconnect()
			.Build();

		hubConnection.On<CorrelationEvent>("EventIngested", async _ =>
		{
			// Run on Blazor's sync context, but bypass RunAsync so we do not
			// toggle the shared `busy` flag while an Ask call is in flight,
			// and explicitly request a re-render — SignalR callbacks do not
			// trigger one automatically the way UI event handlers do.
			try
			{
				var newStatus = await CorrelationApi.GetStatusAsync();
				await InvokeAsync(() =>
				{
					status = newStatus;
					StateHasChanged();
				});
			}
			catch (Exception ex)
			{
				await InvokeAsync(() =>
				{
					error = ex.Message;
					StateHasChanged();
				});
			}
		});

		hubConnection.On<InsightTokenMessage>("InsightTokenAppended", async msg =>
		{
			if (activeStreamId.HasValue && msg.StreamId == activeStreamId.Value)
			{
				await InvokeAsync(() =>
				{
					streamingTokens += msg.TokenDelta;
					StateHasChanged();
				});
			}
		});

		hubConnection.On<InsightCompletedMessage>("InsightAnswerCompleted", async msg =>
		{
			if (activeStreamId.HasValue && msg.StreamId == activeStreamId.Value)
			{
				await InvokeAsync(async () =>
				{
					streamingTokens = msg.FinalAnswer;
					streamingCompleted = true;
					StateHasChanged();
					try { insightHistory = await CorrelationApi.GetRecentInsightsAsync(); StateHasChanged(); } catch { }
				});
			}
		});

		hubConnection.On<AnomalyRecord>("AnomalyDetected", async alert =>
		{
			await InvokeAsync(() =>
			{
				anomalyAlerts = MergeAnomaly(alert, anomalyAlerts, 10);
				StateHasChanged();
			});
		});

		await hubConnection.StartAsync();
	}

	private async Task RefreshAsync()
	{
		await RunAsync(async () =>
		{
			status = await CorrelationApi.GetStatusAsync();
			insightHistory = await CorrelationApi.GetRecentInsightsAsync();
			anomalyAlerts = await CorrelationApi.GetRecentAnomaliesAsync(10);
		});
	}

	private static IReadOnlyList<AnomalyRecord> MergeAnomaly(AnomalyRecord alert, IReadOnlyList<AnomalyRecord> existing, int take) =>
		new[] { alert }
			.Concat(existing.Where(item => item.Id != alert.Id))
			.OrderByDescending(item => item.DetectedAt)
			.Take(take)
			.ToArray();

	private static string SeverityBadgeClass(string severity) => severity.ToLowerInvariant() switch
	{
		"critical" => "text-bg-danger",
		"high" => "text-bg-warning",
		_ => "text-bg-info"
	};

	private static string EventRowClass(CorrelationEvent eventItem) =>
		eventItem.SourceSystem == "System A" && eventItem.EventType == 2
			? "table-warning"
			: eventItem.SourceSystem == "System B" && eventItem.EventType == 9002
				? "table-info"
				: string.Empty;

	private async Task TriggerScenarioAsync()
	{
		await RunAsync(async () =>
		{
			await CorrelationApi.TriggerType2ScenarioAsync();
			status = await CorrelationApi.GetStatusAsync();
		});
	}

	private async Task AskAsync()
	{
		await RunAsync(async () =>
		{
			insight = await CorrelationApi.AskAsync(question);
			status = await CorrelationApi.GetStatusAsync();
			insightHistory = await CorrelationApi.GetRecentInsightsAsync();
		});
	}

	private async Task AskStreamingAsync()
	{
		insight = null;
		streamingTokens = string.Empty;
		streamingCompleted = false;
		streamingDeterministic = null;
		error = null;
		busy = true;
		try
		{
			var response = await CorrelationApi.AskStreamAsync(question);
			if (response is not null)
			{
				activeStreamId = response.StreamId;
				streamingDeterministic = response.DeterministicAnswer;
			}
			status = await CorrelationApi.GetStatusAsync();
		}
		catch (Exception ex)
		{
			error = ex.Message;
		}
		finally
		{
			busy = false;
		}
	}

	private async Task RunAsync(Func<Task> action)
	{
		busy = true;
		error = null;
		try
		{
			await action();
		}
		catch (Exception ex)
		{
			error = ex.Message;
		}
		finally
		{
			busy = false;
		}
	}

	public async ValueTask DisposeAsync()
	{
		if (hubConnection is not null)
		{
			await hubConnection.DisposeAsync();
		}
	}
}
